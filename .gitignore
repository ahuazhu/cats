.DS_Store
__pycache__/
*.py[cod]
.venv/
.env
build/
dist/

# Rust
/target/
/target-linux/

# Local agent worktrees are full repository checkouts, not source assets.
/.worktrees/
/.claude/worktrees/

# Terraform working data and sensitive local plans/state. Provider lock files
# remain committed for reproducible deployments.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.auto.tfvars
backend.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Qualification plans and live production observations are review evidence and
# may expose infrastructure inventory. Keep them outside source control.
deploy/aws/terraform/qualification/**/*.plan.json
deploy/aws/terraform/qualification/**/*.inventory.json

# Scratch binaries from local builds/experiments (a .tmp-blockd once slipped in).
.tmp-*
