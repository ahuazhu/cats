#!/usr/bin/env bash
set -Eeuo pipefail

# Root-only issue-124 administrator adapter. It deliberately exposes only the
# four verbs needed by ha-handoff.sh and validates the complete assignment set
# before either permitted mutation.

API_ORIGIN="https://cats.run"
WORKSPACE_ID="ws_788c5bfc3931"
TOKEN_FILE="/etc/cats/qualification-124/admin-token"

die() { printf 'error: %s\n' "$*" >&2; exit 2; }

[[ "${EUID}" == 0 ]] || die "q124 admin adapter must run as root"
[[ "$#" == 2 ]] || die "usage: q124-admin-node get|cats|cordon|uncordon q124-NODE"
ACTION="$1"
NODE_ID="$2"
case "${ACTION}" in get|cats|cordon|uncordon) ;; *) die "unsupported admin action" ;; esac
[[ "${NODE_ID}" =~ ^q124-[a-z0-9][a-z0-9-]{7,54}$ ]] || die "invalid q124 Node ID"
[[ "${CATS_HA_HOOK_WORKSPACE_ID:-}" == "${WORKSPACE_ID}" ]] || die "invalid workspace scope"
CAT_ID="${CATS_HA_HOOK_CAT_ID:-}"
CAT_NAME="${CATS_HA_HOOK_CAT_NAME:-}"
if [[ -n "${CAT_ID}" || -n "${CAT_NAME}" ]]; then
  [[ "${CAT_ID}" =~ ^cat_[A-Za-z0-9_-]+$ && "${CAT_NAME}" =~ ^q124-[a-z0-9-]+$ ]] ||
    die "invalid q124 Cat scope"
fi
for command in curl jq stat; do command -v "${command}" >/dev/null || die "missing ${command}"; done
[[ -f "${TOKEN_FILE}" && ! -L "${TOKEN_FILE}" ]] || die "missing regular admin token file"
read -r token_uid token_mode < <(stat -c '%u %a' "${TOKEN_FILE}")
[[ "${token_uid}" == 0 && "${token_mode}" == 600 ]] || die "unsafe admin token ownership/mode"
IFS= read -r ADMIN_TOKEN <"${TOKEN_FILE}"
[[ "${ADMIN_TOKEN}" =~ ^[A-Za-z0-9._~-]{20,512}$ ]] || die "invalid admin token format"

request() {
  local method="$1" path="$2"
  printf 'header = "Authorization: Bearer %s"\n' "${ADMIN_TOKEN}" |
    curl --config - --fail-with-body --silent --show-error --max-time 30 \
      --request "${method}" --header 'accept: application/json' \
      --header 'content-length: 0' "${API_ORIGIN}${path}"
}

cats_response="$(request GET "/v1/admin/nodes/${NODE_ID}/cats")"
jq -e --arg node "${NODE_ID}" --arg ws "${WORKSPACE_ID}" \
  --arg cat_id "${CAT_ID}" --arg cat_name "${CAT_NAME}" '
    (keys | sort) == ["items"] and (.items | type == "array" and length <= 1) and
    all(.items[];
      .cat.node_id == $node and .cat.workspace_id == $ws and
      (.cat.id | test("^cat_[A-Za-z0-9_-]+$")) and (.cat.name | startswith("q124-")) and
      (($cat_id == "" and $cat_name == "") or
       (.cat.id == $cat_id and .cat.name == $cat_name)))
  ' <<<"${cats_response}" >/dev/null || die "Node assignment escaped exact q124 scope"

if [[ "${ACTION}" == cats ]]; then
  jq -c '.items' <<<"${cats_response}"
  exit 0
fi

case "${ACTION}" in
  get) response="$(request GET "/v1/admin/nodes/${NODE_ID}")" ;;
  cordon|uncordon)
    response="$(request POST "/v1/admin/nodes/${NODE_ID}/actions/${ACTION}")"
    ;;
esac
jq -e --arg node "${NODE_ID}" '
  .node.id == $node and .node.capacity.cpus == 1 and .node.capacity.memory_mib == 1024 and
  (.assigned_cats | type == "number") and (.assigned_cpus | type == "number") and
  (.assigned_memory_mib | type == "number") and (.orphan_cats | type == "number")
' <<<"${response}" >/dev/null || die "invalid exact NodeSummary response"
jq -c . <<<"${response}"
