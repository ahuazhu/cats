[Unit]
Description=Cats control plane
After=network-online.target
Wants=network-online.target

[Service]
Environment=CATS_CONTROLD_LISTEN=127.0.0.1:7300
EnvironmentFile=/etc/cats/cats.env
ExecStart=/opt/cats/bin/cats-controld \
  --listen ${CATS_CONTROLD_LISTEN} \
  --guest-runtime-profile-receipt-file /opt/cats/release/guest-runtime-profile.v1.json \
  --runtime-provisioner-trust-file /etc/cats/identity/runtime-provisioner-trust.v1.json \
  --db-path /var/lib/cats/control.db
TimeoutStopSec=35s
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
