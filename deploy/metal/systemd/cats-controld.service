[Unit]
Description=Cats control plane
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cats/cats.env
ExecStart=/opt/cats/bin/cats-controld \
  --listen 127.0.0.1:7300 \
  --db-path /var/lib/cats/control.db \
  $CATS_METADATA_STORE_ARGS
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
