[Unit]
Description=Cats node agent (Cloud Hypervisor microVMs)
After=cats-controld.service
Wants=cats-controld.service

[Service]
# The provisioner installs the only NodeIdentity and Host-selected state path.
# This unit has no node-id, hostname, metadata, or state-path override.
# Controlled stop/restart is permitted only at state=cordoned cats=0/orphans=0.
Environment=CATS_GUEST_NETWORK_CIDR=10.240.0.0/16
Environment=CATS_NODE_LISTEN=127.0.0.1:7301
Environment=CATS_NODE_SERVICE_NAME=cats-noded
EnvironmentFile=/etc/cats/cats.env
# The direct-development installer has no validated four-artifact transaction.
# Clear even a stale EnvironmentFile/manager value because the CLI otherwise
# accepts this setting from its process environment.
UnsetEnvironment=CATS_ROUTE_V2_MACHINE_LISTEN
# Per-Cat VMM/blockd processes are PID-1-owned sibling transient services in
# system.slice, not children of this service cgroup. Reap every process that
# does belong to the Agent while leaving those independently owned services
# available for checkpoint + full-inventory adoption after restart.
KillMode=control-group
# Root is required for /dev/kvm, kernel NBD attach and tap devices (Phase A;
# privilege separation is a hardening milestone). The nbd module is loaded
# unconditionally so switching CATS_BLOCK_PATH_ARGS back to kernel-nbd needs no
# reprovisioning; the vhost-user path simply never uses it.
ExecStartPre=/opt/cats/bin/install-guest-runtime-release startup-recover
ExecStartPre=/usr/sbin/modprobe nbd nbds_max=64
ExecStartPre=/opt/cats/bin/setup-guest-network
ExecStart=/opt/cats/bin/cats-noded \
  --listen ${CATS_NODE_LISTEN} \
  --control-plane-url ${CATS_CONTROL_PLANE_URL} \
  --guest-runtime-profile-receipt-file /opt/cats/release/guest-runtime-profile.v1.json \
  --blockd-bin /opt/cats/bin/cats-blockd \
  --guest-agent-bin /opt/cats/bin/cats-guest-agent \
  --vmm-launcher-bin /opt/cats/bin/cats-vmm-launcher \
  --vmm ch \
  --ch-bin /usr/local/bin/cloud-hypervisor \
  --ch-seed-image /opt/cats/guest/rootfs.ext4 \
  $CATS_BLOCK_PATH_ARGS \
  $CATS_METADATA_STORE_ARGS \
  $CATS_OBJECT_STORE_ARGS
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
