# Cats deployment configuration (systemd EnvironmentFile).
# SECURITY: contains credentials; keep mode 0600.

# API token shared by CLI, control plane, node agent and gateway.
CATS_AUTH_TOKEN=dev-token

# Durable blobstore for cats-blockd.
# Local file backend (default; single-host durability only):
CATS_BLOB_ARGS=--blob-file-root /var/lib/cats/blob
# S3 backend (survives host loss — production shape). Uncomment and fill:
#CATS_BLOB_ARGS=--blob-s3-endpoint https://s3.us-east-1.amazonaws.com --blob-s3-bucket YOUR_BUCKET --blob-s3-region us-east-1 --blob-s3-prefix cats
#CATS_S3_ACCESS_KEY=AKIA...
#CATS_S3_SECRET_KEY=...

# Rust log filter for all services.
RUST_LOG=info
