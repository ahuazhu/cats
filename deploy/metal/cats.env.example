# Cats deployment configuration (systemd EnvironmentFile).
# SECURITY: contains credentials; keep mode 0600.

# Internal service token shared only by control plane, node agents and gateway.
CATS_AUTH_TOKEN=dev-service-token

# Fleet management and monitoring token. Never give this to ordinary users.
CATS_ADMIN_TOKEN=dev-admin-token

# Current operator-published and qualified Golden Root. Control automatically
# freezes this exact digest for every newly allocated Cat; users do not choose
# it in the console or CLI.
#CATS_BOOT_IMAGE=sha256:REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS

# Private host-only address space split into one /30 tap per Cat.
CATS_GUEST_NETWORK_CIDR=10.240.0.0/16

# Multi-node cluster. Node identity and state lineage come only from the
# provisioner-owned `/etc/cats/identity` artifact, never from this file. Every
# node must point at the same HTTPS control plane AND the
# same shared storage-meta/object store (SQLite and the file blob store are
# per-host and cannot be shared).
#CATS_CONTROLD_LISTEN=10.0.0.1:7300
#CATS_NODE_LISTEN=10.0.0.2:7301
CATS_CONTROL_PLANE_URL=https://control.internal.example
CATS_NODE_ID=node_01
CATS_NODE_NAME=metal-1
CATS_NODE_VENDOR=metal
CATS_NODE_REGION=local
CATS_NODE_ZONE=rack-a
CATS_NODE_INSTANCE_ID=host-01
CATS_NODE_MACHINE_TYPE=bare-metal
CATS_NODE_CONTROL_ENDPOINT=http://10.0.0.2:7301
CATS_NODE_TOTAL_CPU=32
CATS_NODE_TOTAL_MEMORY=68719476736

# PostgreSQL storage-meta (required for a cluster; root/lease CAS per ADR-0003).
#CATS_METADATA_STORE_ARGS=--metadata-store-adapter postgres
#CATS_POSTGRES_URL=postgres://user:password@host:5432/catsmeta?sslmode=require

# Guest block data path. Empty means the default kernel-NBD path. The native
# vhost-user-blk frontend (ADR-0015) needs no nbd module
# and no /dev/nbdN; one queue per Guest vCPU is a reasonable starting point.
CATS_BLOCK_PATH_ARGS=
#CATS_BLOCK_PATH_ARGS=--ch-block-path vhost-user --ch-vhost-user-queues 2

# Provider-neutral adapter selection. Adapter options are configuration, not
# credentials; secrets use the adapter's native environment/workload identity.
CATS_METADATA_STORE_ARGS=--metadata-store-adapter sqlite --metadata-store-option path=/var/lib/cats/storage-meta.db

# Local file adapter (development only; permanent host loss loses data):
CATS_OBJECT_STORE_ARGS=--object-store-adapter file --object-store-option root=/var/lib/cats/blob
# First durable adapter: AWS S3. Uncomment and fill:
#CATS_OBJECT_STORE_ARGS=--object-store-adapter aws-s3 --object-store-option bucket=YOUR_BUCKET --object-store-option region=us-east-1 --object-store-option prefix=cats
#AWS_ACCESS_KEY_ID=AKIA...
#AWS_SECRET_ACCESS_KEY=...
#AWS_SESSION_TOKEN=... # only for temporary credentials

# Rust log filter for all services.
RUST_LOG=info
