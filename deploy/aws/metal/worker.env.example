# Secrets belong in /etc/cats/worker.env (mode 0600), not in this file.
# Node identity and its state path are installed only by the host provisioner
# under /etc/cats/identity; environment values cannot override them.
CATS_CONTROL_PLANE_URL=https://cats.run
CATS_AWS_REGION=us-east-1
CATS_S3_BUCKET=YOUR_CATS_BUCKET
# Exact canonical prefix shared by the reset receipt, cats-controld and blockd.
CATS_CHUNKSTORE_PREFIX=cats
# The database password has one authority: the RDS managed master secret.
# Point at it and render-postgres-url composes the DSN into
# /run/cats/postgres-url before every worker start and on a timer, so a
# rotation costs nothing. These four are not secrets.
# CATS_POSTGRES_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT:secret:rds!db-XXXX
# CATS_POSTGRES_HOST=RDS_HOST
# CATS_POSTGRES_PORT=5432
# CATS_POSTGRES_DATABASE=cats
# CATS_POSTGRES_SSLMODE=require
#
# Development only, and only when CATS_POSTGRES_SECRET_ARN is unset: a fixed
# DSN that nothing rotates. Never use this against an instance with managed
# rotation enabled -- the copy goes stale in silence and only new connections
# fail, which reads as a component bug rather than a credential.
CATS_POSTGRES_URL=postgresql://USER:PASSWORD@RDS_HOST:5432/cats?sslmode=require
CATS_GUEST_NETWORK_CIDR=10.240.0.0/16
# Set this from the host's discovered cgroup2 mount and systemd ControlGroup.
# The Terraform SSM deployment computes it; do not assume a fixed host path.
CATS_METERING_CGROUP_ROOT=DISCOVERED_CGROUP2_SERVICE_PATH/metering
RUST_LOG=info
