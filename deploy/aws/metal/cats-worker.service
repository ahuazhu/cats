[Unit]
Description=Cats bare-metal worker
After=network-online.target
Wants=network-online.target

[Service]
Delegate=cpu memory
# Keep systemd's default KillMode=control-group until #186 makes ledger
# persistence and every in-flight lifecycle crash window safely re-adoptable.
# A controlled worker release must drain to cats=0/orphans=0 before stopping.
Environment=CATS_GUEST_NETWORK_CIDR=10.240.0.0/16
# Direct RDS remains the compatible default. A managed worker environment can
# override this after the proxy exists and has passed its connectivity check.
Environment=CATS_POSTGRES_SESSION_SETUP=client
EnvironmentFile=/etc/cats/worker.env
ExecStartPre=/usr/sbin/modprobe nbd nbds_max=64
ExecStartPre=/opt/cats/bin/setup-guest-network
# Every start renders the DSN afresh from its authority. A restart is the one
# moment a stale credential is guaranteed to bite, and it used to be the moment
# the old copy was reused.
ExecStartPre=/opt/cats/bin/render-postgres-url
ExecStart=/opt/cats/bin/cats-noded \
  --node-id $CATS_NODE_ID \
  --listen 0.0.0.0:7301 \
  --advertise-url $CATS_NODE_ADVERTISE_URL \
  --initially-cordoned \
  --control-plane-url $CATS_CONTROL_PLANE_URL \
  --route-grant-public-key-file /etc/cats/route-grant-public.pem \
  --gateway-url $CATS_GATEWAY_URL \
  --state-dir /var/lib/cats/node \
  --blockd-bin /opt/cats/bin/cats-blockd \
  --guest-agent-bin /opt/cats/bin/cats-guest-agent \
  --metadata-store-adapter postgres \
  --metadata-store-option url-file=/run/cats/postgres-url \
  --metadata-store-option ca-file=/etc/cats/rds-ca.pem \
  --metadata-store-option session-setup=${CATS_POSTGRES_SESSION_SETUP} \
  --object-store-adapter aws-s3 \
  --object-store-option bucket=${CATS_S3_BUCKET} \
  --object-store-option region=${CATS_AWS_REGION} \
  --object-store-option prefix=cats \
  --vmm ch \
  --ch-bin /opt/cats/bin/cloud-hypervisor \
  --ch-kernel /opt/cats/guest/vmlinuz \
  --ch-initramfs /opt/cats/guest/initramfs.img \
  --ch-cmdline "console=ttyS0 root=/dev/vda rw clocksource=kvm-clock" \
  --ch-network-cidr $CATS_GUEST_NETWORK_CIDR \
  --ch-seed-image /opt/cats/guest/rootfs.ext4
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
