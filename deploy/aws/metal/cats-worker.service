[Unit]
Description=Cats bare-metal worker
After=network-online.target
Wants=network-online.target

[Service]
Delegate=cpu memory
# The deployment transaction cross-checks the provisioned Node identity with
# IMDS and writes the resulting registration fields into this root-only file.
# Controlled stop/restart is permitted only at state=cordoned cats=0/orphans=0.
Environment=CATS_GUEST_NETWORK_CIDR=10.240.0.0/16
# Direct RDS remains the compatible default. A managed worker environment can
# override this after the proxy exists and has passed its connectivity check.
Environment=CATS_POSTGRES_SESSION_SETUP=client
EnvironmentFile=/etc/cats/worker.env
# Cloud Hypervisor and blockd are direct children of noded. A service stop is
# the Host-local process fence and must reap the complete cgroup.
KillMode=control-group
ExecStartPre=/opt/cats/bin/install-guest-runtime-release startup-recover
ExecStartPre=/usr/sbin/modprobe nbd nbds_max=64
ExecStartPre=/opt/cats/bin/setup-guest-network
# Every start renders the DSN afresh from its authority. A restart is the one
# moment a stale credential is guaranteed to bite, and it used to be the moment
# the old copy was reused.
ExecStartPre=/opt/cats/bin/render-postgres-url
ExecStart=/opt/cats/bin/cats-noded \
  --listen 0.0.0.0:7301 \
  --control-plane-url $CATS_CONTROL_PLANE_URL \
  --control-endpoint $CATS_NODE_CONTROL_ENDPOINT \
  --node-id $CATS_NODE_ID \
  --node-name $CATS_NODE_NAME \
  --vendor $CATS_NODE_VENDOR \
  --region $CATS_NODE_REGION \
  --zone $CATS_NODE_ZONE \
  --instance-id $CATS_NODE_INSTANCE_ID \
  --machine-type $CATS_NODE_MACHINE_TYPE \
  --total-cpu $CATS_NODE_TOTAL_CPU \
  --total-memory $CATS_NODE_TOTAL_MEMORY \
  --guest-runtime-profile-receipt-file /opt/cats/release/guest-runtime-profile.v1.json \
  --blockd-bin /opt/cats/bin/cats-blockd \
  --host-lock /var/lib/cats/node/host.lock \
  --blockd-socket-root /run/cats/blockd-v1 \
  --effect-timeout-ms 30000 \
  --metadata-store-adapter postgres \
  --metadata-store-option url-file=/run/cats/postgres-url \
  --metadata-store-option ca-file=/etc/cats/rds-ca.pem \
  --metadata-store-option session-setup=${CATS_POSTGRES_SESSION_SETUP} \
  --object-store-adapter aws-s3 \
  --object-store-option bucket=${CATS_S3_BUCKET} \
  --object-store-option region=${CATS_AWS_REGION} \
  --object-store-option prefix=${CATS_CHUNKSTORE_PREFIX} \
  --vmm ch \
  --ch-bin /opt/cats/bin/cloud-hypervisor \
  --ch-seed-image /opt/cats/guest/rootfs.ext4 \
  --ch-block-path kernel-nbd
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
