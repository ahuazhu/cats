# No syntax directive: the qualification build host cannot reach Docker Hub,
# where the external frontend image lives. BuildKit's built-in frontend covers
# every construct used here, and the manual-release lock pins the BuildKit
# version, so the parser stays deterministic.
# Pin both cargo-chef and its multi-platform image. The recipe layer changes
# only when Cargo manifests or Cargo.lock change, so ordinary source edits
# reuse the optimized third-party dependency build.
# The qualification build host reaches AWS registries only: its VPC S3
# endpoint policy denies the Docker Hub blob bucket, so Docker Hub base images
# are unreachable there. Pull the same upstream Rust image from Amazon ECR Public and add
# the pinned cargo-chef, keeping the recipe-layer caching behaviour.
FROM public.ecr.aws/docker/library/rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS chef
RUN cargo install cargo-chef --locked --version 0.1.77

WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG CATS_RELEASE_COMMIT_SHA
ENV CATS_RELEASE_COMMIT_SHA=${CATS_RELEASE_COMMIT_SHA}
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json \
    -p cats-control-plane-daemon

COPY . .
RUN test "${CATS_RELEASE_COMMIT_SHA}" != "" \
    && printf '%s' "${CATS_RELEASE_COMMIT_SHA}" | grep -Eq '^[0-9a-f]{40}$' \
    && cargo build --locked --release \
      -p cats-control-plane-daemon \
      -p cats-object-write-gateway-daemon \
    && strip target/release/cats-controld \
    && strip target/release/cats-object-write-gatewayd \
    && install -D -m 0755 target/release/cats-controld /out/cats-controld \
    && install -D -m 0755 target/release/cats-object-write-gatewayd /out/cats-object-write-gatewayd

FROM public.ecr.aws/docker/library/debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241 AS runtime

# The qualification build host allows outbound 443 only, so apt must use
# HTTPS; the trust anchors come from the digest-pinned builder image because
# bookworm-slim ships without ca-certificates.
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 cats \
    && useradd --uid 10001 --gid cats --home-dir /var/lib/cats --create-home cats \
    && install -d -o 0 -g 0 -m 0755 /etc/cats/identity

COPY --from=builder /out/cats-controld /usr/local/bin/cats-controld
# The object-write gateway Deployment runs this same image with an explicit
# command; the binary must ship here or that pod can never start.
COPY --from=builder /out/cats-object-write-gatewayd /usr/local/bin/cats-object-write-gatewayd
# Produced once by the Guest release job and shared byte-for-byte with the
# worker bundle. A missing payload is a build failure, never a runtime default.
COPY --chown=0:0 --chmod=0644 guest-runtime-release.v1/guest-runtime-profile.v1.json /opt/cats/release/guest-runtime-profile.v1.json
COPY --chown=0:0 --chmod=0644 guest-runtime-release.v1/manifest.v1.json /opt/cats/release/guest-runtime-release-manifest.v1.json

USER 10001:10001
WORKDIR /var/lib/cats
EXPOSE 7300
ENTRYPOINT ["/usr/local/bin/cats-controld"]

# The in-cluster credential refresher (ADR-0029). A separate target rather than
# a separate Dockerfile so it inherits this image's base, CA bundle and non-root
# user, and so the deployment builds and digest-pins both the same way.
#
# It needs three things the control plane does not: the AWS CLI to read the
# managed secret, psql to prove the composed DSN authenticates before anything
# is written, and curl to patch the Kubernetes Secret through the API. kubectl
# is deliberately absent -- one PATCH against one Secret does not justify
# shipping a cluster binary, and the ServiceAccount token plus curl is a
# narrower tool for the job.
FROM runtime AS credential-refresher

USER 0:0
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
         awscli curl postgresql-client python3-minimal \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/aws/swap-dsn-password.py /usr/local/bin/swap-dsn-password.py
COPY deploy/aws/refresh-database-credential.sh /usr/local/bin/refresh-database-credential
RUN chmod 0755 /usr/local/bin/swap-dsn-password.py \
                /usr/local/bin/refresh-database-credential

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/refresh-database-credential"]
