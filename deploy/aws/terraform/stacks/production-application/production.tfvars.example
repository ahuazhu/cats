kubeconfig_path    = "/absolute/path/to/kubeconfig"
kubeconfig_context = "REPLACE_WITH_PRODUCTION_EKS_CONTEXT"
expected_account_id    = "REPLACE_WITH_12_DIGIT_PRODUCTION_ACCOUNT_ID"
expected_aws_partition = "aws"
aws_region             = "us-east-1"

# Set true only through a reviewed saved plan for Operations and HA §8.
# This removes public ingress/DNS and scales cats-controld to zero without
# creating out-of-band Kubernetes drift. Re-plan with false only in the exact
# terminal-release plan that selects disjoint fresh data/usage targets; route
# and mutation admission remain Closed until qualification and old retirement.
maintenance_mode = false
# Keep false through fresh qualification and exact old retirement. Enabling
# public ingress is a separate reviewed post-reset transition and does not
# establish the Control/Node mutation-admission proof by itself.
enable_public_ingress = false

# Warm snapshots are outside the first release. Zero disables automatic Warm.
auto_warm_after_seconds = 0

control_plane_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/cats-control-plane@sha256:REPLACE_WITH_64_HEX_CHARACTERS"
gateway_image       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/cats-control-plane@sha256:REPLACE_WITH_GATEWAY_64_HEX_CHARACTERS"
object_write_gateway_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/cats-control-plane@sha256:REPLACE_WITH_OBJECT_WRITE_GATEWAY_64_HEX_CHARACTERS"

# These versioned Secrets are created through the root-only credential channel
# before planning. They must be immutable and have exactly the documented
# closed key sets; Terraform receives only their opaque names.
route_v2_control_artifact_secret_name = "cats-route-v2-control-r1"
route_v2_gateway_artifact_secret_name = "cats-route-v2-gateway-r1"
object_write_gateway_tls_secret_name  = "cats-object-write-gateway-tls-r1"
endpoint_wildcard_host                = "*.cats.run"
chunkstore_bucket_name   = "REPLACE_WITH_PLATFORM_CHUNKSTORE_BUCKET_OUTPUT"
chunkstore_prefix        = "cats-fresh"
control_postgres_schema  = "cats_fresh"
usage_postgres_schema    = "cats_usage_fresh"

usage_delivery_adapter = "aws-kinesis"
usage_aws_region        = "us-east-1"
usage_kinesis_stream    = "REPLACE_WITH_USAGE_STREAM"
usage_archive_bucket    = "REPLACE_WITH_USAGE_ARCHIVE_BUCKET"
usage_checkpoint_table  = "REPLACE_WITH_USAGE_CHECKPOINT_TABLE"

stripe_enabled  = true
stripe_livemode = true
stripe_topup_price_ids = {
  "1000"  = "price_REPLACE_10"
  "2500"  = "price_REPLACE_25"
  "5000"  = "price_REPLACE_50"
  "10000" = "price_REPLACE_100"
}

acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"
public_subnet_ids = [
  "subnet-REPLACE_A",
  "subnet-REPLACE_B",
]
private_subnet_ids = [
  "subnet-REPLACE_PRIVATE_A",
  "subnet-REPLACE_PRIVATE_B",
]

# Exact platform outputs. The NLB SG admits only the metal-worker SG; the
# private DNS name is the sole serverAuth SAN and never the generated ELB name.
object_write_gateway_nlb_security_group_id = "sg-REPLACE"
object_write_gateway_private_zone_id       = "Z_REPLACE_PRIVATE_ZONE"
object_write_gateway_private_dns_name      = "gateway.object-write.production.cats.internal"
object_write_spool_file_system_id           = "fs-REPLACE"
object_write_spool_access_point_id          = "fsap-REPLACE"

# Do not put runtime_secret_data, route_grant_private_key_pem or its CI-derived
# route_grant_public_key_pem, runtime_provisioner_trust_bundle_json,
# storage_postgres_url, usage_postgres_url, stripe_secret_key,
# stripe_webhook_secret, or rds_ca_pem in this file. Supply them through
# TF_VAR_* or the central provisioning/CI store.
