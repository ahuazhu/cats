aws_region               = "us-east-1"
environment              = "production"
eks_cluster_name         = "REPLACE_WITH_PRODUCTION_EKS_CLUSTER"
usage_archive_bucket_name = "REPLACE_WITH_GLOBALLY_UNIQUE_CATS_USAGE_BUCKET"

# Start with one provisioned shard. Scale only from CloudWatch throughput and
# throttling measurements.
usage_kinesis_shard_count      = 1
usage_kinesis_retention_hours  = 24
usage_consumer_lag_alarm_threshold_ms = 60000
usage_archive_object_lock_days = 2555

alarm_sns_topic_arns = []

worker_artifact_bucket_name    = "REPLACE_WITH_GLOBALLY_UNIQUE_CATS_WORKER_ARTIFACT_BUCKET"
worker_bundle_path             = "/absolute/path/to/dist/worker/cats-worker.tar.zst"
worker_bundle_sha256           = "REPLACE_WITH_64_HEX_CHARACTERS"
metal_worker_instances = {
  "metal-1" = "i-REPLACE"
}
metal_worker_instance_role_name = "REPLACE_WITH_INSTANCE_ROLE_NAME"

# Rolling release across a serving fleet: drain one worker, apply with only it
# listed here, undrain, then move to the next. Omit to deploy every worker.
# Never subset while rotating worker_runtime_secret_data: an omitted worker
# keeps the old token and drops off the control plane when the new one lands.
# metal_worker_deploy_instances = ["metal-1"]

# Supply worker_runtime_secret_data through TF_VAR_worker_runtime_secret_data
# or the approved CI secret store; do not put it in this file.

# After the platform RDS Proxy target is AVAILABLE, supply these through an
# approved non-secret tfvars source and roll one drained worker at a time:
# worker_managed_environment = {
#   CATS_POSTGRES_HOST          = "REPLACE_WITH_DATABASE_PROXY_ENDPOINT"
#   CATS_POSTGRES_PORT          = "5432"
#   CATS_POSTGRES_DATABASE      = "cats"
#   CATS_POSTGRES_SSLMODE       = "verify-full"
#   CATS_POSTGRES_SESSION_SETUP = "server-verified"
# }
# Keep database_master_user_secret_arn set from the platform output. Restoring
# the direct database host and "client" mode is the rollback path.

tags = {
  Owner = "platform"
}
