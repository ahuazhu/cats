aws_region  = "us-east-1"
environment = "production"

# Fail closed if credentials resolve to another AWS account or partition.
expected_account_id    = "REPLACE_WITH_12_DIGIT_PRODUCTION_ACCOUNT_ID"
expected_aws_partition = "aws"

# Network. Keep clear of CATS_GUEST_NETWORK_CIDR (10.240.0.0/16).
vpc_cidr                = "10.20.0.0/16"
availability_zone_count = 2
one_nat_gateway_per_az  = true

# Cluster. Dedicated to Cats — do not point this at another product's cluster.
cluster_name       = "cats-production"
kubernetes_version = "1.34"

# Narrow this to the operator egress ranges once they are known.
cluster_public_access_cidrs  = ["0.0.0.0/0"]
cluster_admin_principal_arns = []

# Database.
database_engine_version        = "16.13"
database_instance_class        = "db.t4g.micro"
database_allocated_storage     = 20
database_multi_az              = true
database_backup_retention_days = 7
database_deletion_protection   = true
database_skip_final_snapshot   = false

# Actual recipients belong only in the ignored operator tfvars. Every address
# must click the AWS confirmation email before the alarm preflight can pass.
alert_email_recipients = {
  primary_oncall = "REPLACE_WITH_OPERATOR_ALERT_EMAIL"
}

# Worker capacity. Stable keys replace positional identities. These subnet
# indices match the imported production Hosts exactly: legacy metal-2 is in the
# first private subnet and metal-1 is in the second. false records metal-2's
# current unencrypted root so an ordinary plan does not replace it. In the
# approved maintenance window, change only that value to true and retain the
# exact reviewed replacement plan; never set metal-1 back to false.
metal_workers = {
  "metal-2" = {
    subnet_index          = 0
    root_volume_encrypted = false
  }
  "metal-1" = {
    subnet_index          = 1
    root_volume_encrypted = true
  }
}

# DNS. Leave wait_for_certificate_validation false until the registrar points
# at this zone's name servers; ACM cannot validate before that and the apply
# would sit waiting for a record the world cannot resolve.
domain_name                     = "cats.run"
wait_for_certificate_validation = false

# Release identity.
github_repository           = "ahuazhu/cats"
github_default_branch       = "main"
create_github_oidc_provider = true
ecr_repository_name         = "cats/control-plane"

# Exact application state the main-branch deployment role may plan and apply.
# Keep the account-specific bucket ARN outside the repository.
github_actions_application_state_bucket_arn = "arn:aws:s3:::REPLACE_WITH_TERRAFORM_STATE_BUCKET"
github_actions_application_state_key        = "cats/production/application.tfstate"

tags = {
  Owner = "platform"
}
