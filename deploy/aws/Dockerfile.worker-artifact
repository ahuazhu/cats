# No syntax directive: the qualification build host cannot reach Docker Hub,
# where the external frontend image lives. BuildKit's built-in frontend covers
# every construct used here, and the manual-release lock pins the BuildKit
# version, so the parser stays deterministic.
# Keep this builder identical to the control-plane builder: cargo-chef requires
# the same Rust version for the dependency and application stages to share
# artifacts reliably.
# The qualification build host reaches AWS registries only: its VPC S3
# endpoint policy denies the Docker Hub blob bucket, so Docker Hub base images
# are unreachable there. Pull the same upstream Rust image from Amazon ECR Public and add
# the pinned cargo-chef, keeping the recipe-layer caching behaviour.
FROM public.ecr.aws/docker/library/rust:1.97.1-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS chef
RUN cargo install cargo-chef --locked --version 0.1.77

WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
ARG CATS_RELEASE_COMMIT_SHA
ENV CATS_RELEASE_COMMIT_SHA=${CATS_RELEASE_COMMIT_SHA}
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json \
    -p cats-cli \
    -p cats-node-agent-daemon \
    -p cats-blockd-daemon \
    -p cats-guest-agent

COPY . .
RUN test "${CATS_RELEASE_COMMIT_SHA}" != "" \
    && printf '%s' "${CATS_RELEASE_COMMIT_SHA}" | grep -Eq '^[0-9a-f]{40}$' \
    && cargo build --locked --release \
      -p cats-cli \
      -p cats-node-agent-daemon \
      -p cats-blockd-daemon \
      -p cats-guest-agent \
    && strip \
      target/release/cats \
      target/release/cats-noded \
      target/release/cats-route-v2-node-r1-validator \
      target/release/cats-vmm-launcher \
      target/release/cats-runtime-e3-probe \
      target/release/cats-usage-schema-v16-verifier \
      target/release/cats-usage-terminal-receipt-verifier \
      target/release/cats-blockd \
      target/release/cats-guest-agent \
      target/release/cats-e3-guest-workload \
    && install -D -m 0755 target/release/cats /out/cats \
    && install -D -m 0755 target/release/cats-noded /out/cats-noded \
    && install -D -m 0755 target/release/cats-route-v2-node-r1-validator /out/cats-route-v2-node-r1-validator \
    && install -D -m 0755 target/release/cats-vmm-launcher /out/cats-vmm-launcher \
    && install -D -m 0755 target/release/cats-runtime-e3-probe /out/cats-runtime-e3-probe \
    && install -D -m 0755 target/release/cats-usage-schema-v16-verifier /out/cats-usage-schema-v16-verifier \
    && install -D -m 0755 target/release/cats-usage-terminal-receipt-verifier /out/cats-usage-terminal-receipt-verifier \
    && install -D -m 0755 target/release/cats-blockd /out/cats-blockd \
    && install -D -m 0755 target/release/cats-guest-agent /out/cats-guest-agent \
    && install -D -m 0755 target/release/cats-e3-guest-workload /out/cats-e3-guest-workload

COPY --chmod=0755 deploy/metal/setup-guest-network.sh /out/setup-guest-network.sh
COPY --chmod=0755 deploy/aws/metal/update-guest-seed.sh /out/update-guest-seed.sh
COPY --chmod=0755 deploy/aws/metal/require-idle-worker.sh /out/require-idle-worker.sh
COPY --chmod=0755 deploy/aws/old-host-positive-stop.py /out/old-host-positive-stop.py
COPY --chmod=0755 deploy/aws/metal/render-postgres-url.sh /out/render-postgres-url.sh
COPY --chmod=0755 deploy/aws/metal/install-guest-runtime-release.sh /out/install-guest-runtime-release.sh
COPY --chmod=0755 deploy/aws/metal/validate-node-identity-installation.sh /out/validate-node-identity-installation.sh
COPY --chmod=0755 deploy/aws/metal/install-route-v2-node-r1.sh /out/install-route-v2-node-r1.sh
COPY --chmod=0755 deploy/aws/metal/worker-deployment-transaction.sh /out/worker-deployment-transaction.sh
COPY deploy/metal/guest-systemd /out/guest-systemd
RUN chmod 0755 /out/guest-systemd && chmod 0644 /out/guest-systemd/*

FROM scratch AS artifact

COPY --from=builder /out/cats /cats
COPY --from=builder /out/cats-noded /cats-noded
COPY --from=builder /out/cats-route-v2-node-r1-validator /cats-route-v2-node-r1-validator
COPY --from=builder /out/cats-vmm-launcher /cats-vmm-launcher
COPY --from=builder /out/cats-runtime-e3-probe /cats-runtime-e3-probe
COPY --from=builder /out/cats-usage-schema-v16-verifier /cats-usage-schema-v16-verifier
COPY --from=builder /out/cats-usage-terminal-receipt-verifier /cats-usage-terminal-receipt-verifier
COPY --from=builder /out/cats-blockd /cats-blockd
COPY --from=builder /out/cats-guest-agent /cats-guest-agent
COPY --from=builder /out/cats-e3-guest-workload /cats-e3-guest-workload
COPY --from=builder --chmod=0755 /out/setup-guest-network.sh /setup-guest-network.sh
COPY --from=builder --chmod=0755 /out/update-guest-seed.sh /update-guest-seed.sh
COPY --from=builder --chmod=0755 /out/require-idle-worker.sh /require-idle-worker.sh
COPY --from=builder --chmod=0755 /out/old-host-positive-stop.py /old-host-positive-stop.py
COPY --from=builder --chmod=0755 /out/render-postgres-url.sh /render-postgres-url.sh
COPY --from=builder --chmod=0755 /out/install-guest-runtime-release.sh /install-guest-runtime-release.sh
COPY --from=builder --chmod=0755 /out/validate-node-identity-installation.sh /validate-node-identity-installation.sh
COPY --from=builder --chmod=0755 /out/install-route-v2-node-r1.sh /install-route-v2-node-r1.sh
COPY --from=builder --chmod=0755 /out/worker-deployment-transaction.sh /worker-deployment-transaction.sh
COPY --from=builder /out/guest-systemd /guest-systemd
COPY --chmod=0644 deploy/aws/metal/cats-worker.service /cats-worker.service
COPY --chmod=0644 deploy/aws/metal/cats-postgres-url.service /cats-postgres-url.service
COPY --chmod=0644 deploy/aws/metal/cats-postgres-url.timer /cats-postgres-url.timer
# The same immutable payload directory consumed by Dockerfile.control-plane.
# No worker-local kernel/receipt generator is permitted in this build.
COPY guest-runtime-release.v1 /guest-runtime-release.v1
