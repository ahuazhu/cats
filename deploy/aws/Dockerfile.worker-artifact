# syntax=docker/dockerfile:1.7
# Keep this builder identical to the control-plane builder: cargo-chef requires
# the same Rust version for the dependency and application stages to share
# artifacts reliably.
FROM lukemathwalker/cargo-chef:0.1.77-rust-1.97-bookworm@sha256:1689f62cfaa6603480356923cb5966544b2dd6ea523e30486bee4f149965d5bc AS chef

WORKDIR /src

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /src/recipe.json recipe.json
RUN cargo chef cook --locked --release --recipe-path recipe.json \
    -p cats-node-agent-daemon \
    -p cats-blockd-daemon \
    -p cats-guest-agent

COPY . .
RUN cargo build --locked --release \
      -p cats-node-agent-daemon \
      -p cats-blockd-daemon \
      -p cats-guest-agent \
    && strip \
      target/release/cats-noded \
      target/release/cats-blockd \
      target/release/cats-guest-agent \
    && install -D -m 0755 target/release/cats-noded /out/cats-noded \
    && install -D -m 0755 target/release/cats-blockd /out/cats-blockd \
    && install -D -m 0755 target/release/cats-guest-agent /out/cats-guest-agent

COPY deploy/aws/metal/update-guest-seed.sh /out/update-guest-seed.sh
COPY deploy/aws/metal/require-idle-worker.sh /out/require-idle-worker.sh
COPY deploy/aws/metal/render-postgres-url.sh /out/render-postgres-url.sh
COPY --chmod=0755 deploy/aws/metal/install-guest-runtime-release.sh /out/install-guest-runtime-release.sh
COPY --chmod=0755 deploy/aws/metal/validate-node-identity-installation.sh /out/validate-node-identity-installation.sh
COPY --chmod=0755 deploy/aws/metal/worker-deployment-transaction.sh /out/worker-deployment-transaction.sh
COPY deploy/metal/guest-systemd /out/guest-systemd

FROM scratch AS artifact

COPY --from=builder /out/cats-noded /cats-noded
COPY --from=builder /out/cats-blockd /cats-blockd
COPY --from=builder /out/cats-guest-agent /cats-guest-agent
COPY --from=builder /out/update-guest-seed.sh /update-guest-seed.sh
COPY --from=builder /out/require-idle-worker.sh /require-idle-worker.sh
COPY --from=builder /out/render-postgres-url.sh /render-postgres-url.sh
COPY --from=builder --chmod=0755 /out/install-guest-runtime-release.sh /install-guest-runtime-release.sh
COPY --from=builder --chmod=0755 /out/validate-node-identity-installation.sh /validate-node-identity-installation.sh
COPY --from=builder --chmod=0755 /out/worker-deployment-transaction.sh /worker-deployment-transaction.sh
COPY --from=builder /out/guest-systemd /guest-systemd
COPY deploy/aws/metal/cats-worker.service /cats-worker.service
COPY deploy/aws/metal/cats-postgres-url.service /cats-postgres-url.service
COPY deploy/aws/metal/cats-postgres-url.timer /cats-postgres-url.timer
# The same immutable payload directory consumed by Dockerfile.control-plane.
# No worker-local kernel/receipt generator is permitted in this build.
COPY guest-runtime-release.v1 /guest-runtime-release.v1
