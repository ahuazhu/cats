{
  "vector_version": 1,
  "base_vector": "positive.json",
  "assembly": "For a case with token_parts, replace each $positive value with the same named field from positive.json, then join header_base64url, claims_base64url and signature_base64url with ASCII dots.",
  "cases": [
    {
      "name": "too-many-segments",
      "compact": "a.b.c.d",
      "expected_class": "malformed_envelope"
    },
    {
      "name": "padding-forbidden",
      "token_parts": {
        "header_base64url": "$positive.header_base64url=",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "$positive.signature_base64url"
      },
      "expected_class": "malformed_envelope"
    },
    {
      "name": "invalid-base64url-character",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "*"
      },
      "expected_class": "malformed_envelope"
    },
    {
      "name": "signed-unknown-header",
      "token_parts": {
        "header_base64url": "eyJhbGciOiJFZERTQSIsImtpZCI6IjIxZmUzMWRmYTE1NGEyNjE2MjZiZjg1NDA0NmZkMjI3MWI3YmVkNGI2YWJlNDVhYTU4ODc3ZWY0N2Y5NzIxYjkiLCJ0eXAiOiJjYXRzLXJvdXRlLWdyYW50K2p3dCIsInYiOjEsIngiOjF9",
