      },
      "expected_class": "noncanonical_encoding"
    },
    {
      "name": "signed-version-two",
      "token_parts": {
        "header_base64url": "eyJhbGciOiJFZERTQSIsImtpZCI6IjIxZmUzMWRmYTE1NGEyNjE2MjZiZjg1NDA0NmZkMjI3MWI3YmVkNGI2YWJlNDVhYTU4ODc3ZWY0N2Y5NzIxYjkiLCJ0eXAiOiJjYXRzLXJvdXRlLWdyYW50K2p3dCIsInYiOjJ9",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "YkHRlSCNsLVocZT9I8hdzsJkCpEw4cbWn1YOa1gpTWWCVWIMVOnV08ccBb13Q1KpjNqNWPeuM4IU0XMfaMe4Cw"
      },
      "expected_class": "unsupported_version"
    },
    {
      "name": "signed-wrong-algorithm",
      "token_parts": {
        "header_base64url": "eyJhbGciOiJFUzI1NiIsImtpZCI6IjIxZmUzMWRmYTE1NGEyNjE2MjZiZjg1NDA0NmZkMjI3MWI3YmVkNGI2YWJlNDVhYTU4ODc3ZWY0N2Y5NzIxYjkiLCJ0eXAiOiJjYXRzLXJvdXRlLWdyYW50K2p3dCIsInYiOjF9",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "ckgUGJhRlw8qfQvSmisV6RhdnV_eWfehDGk036_2Y_e72Y0pn89wlM55KGk9bAdL9Huwnm0OmAdXJDLTFtZTAg"
      },
      "expected_class": "unsupported_algorithm"
    },
    {
      "name": "signed-unknown-kid",
      "token_parts": {
        "header_base64url": "eyJhbGciOiJFZERTQSIsImtpZCI6IjAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAiLCJ0eXAiOiJjYXRzLXJvdXRlLWdyYW50K2p3dCIsInYiOjF9",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "HHCbODGSoqSl9yIszj31H1ItAlFOS59vEfQZnGUbH1cI6khPIajKembxNBtuclULwbnx0n1Y3YkN06KXiRz8BQ"
      },
      "expected_class": "unknown_key"
    },
    {
      "name": "tampered-target-port",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "",
        "signature_base64url": "$positive.signature_base64url"
      },
      "expected_class": "invalid_signature"
    },
    {
      "name": "noncanonical-ed25519-s-plus-group-order",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "$positive.claims_base64url",
        "signature_base64url": "DG5Ofbp8D6Bgw5Rfx1s4370wjJJwT2D15d80D2BnBVzlC5DrlYYU_Xjtk8T-1U92RPhHeyiPOTayVUmi982XFQ"
      },
      "expected_class": "noncanonical_encoding"
    },
    {
      "name": "signed-unknown-claim",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "",
        "signature_base64url": "xrzxiaiL9J0kq1uoOyqdvyCMlctH4tw5arZFh_2pkvGibT5DCDWRfBtnGGNkoWS_z2-osDlHSU_3dyqKN0ejAg"
      },
      "expected_class": "invalid_claims"
    },
    {
      "name": "signed-duplicate-target-port",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "",
        "signature_base64url": "A6idnNURAyxYjtsaz1Q6egcYOIrbnPmElrH4jCYIXMqxY-vTmyZlkTyTMADpuIY04FfyuWTOKCywckXT0VOUDA"
      },
      "expected_class": "noncanonical_encoding"
    },
    {
      "name": "signed-noncanonical-claims-order-and-whitespace",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "",
        "signature_base64url": "WvIXqY6CeRKlnCQN6QDYjMSOEP5k0YYp4_GNHy4bhHki0gSFYJs18MYGJcyQ2rnd2sLfT98yVKc6WmzueysHDg"
      },
      "expected_class": "noncanonical_encoding"
    },
    {
      "name": "signed-lifetime-121-seconds",
      "token_parts": {
        "header_base64url": "$positive.header_base64url",
        "claims_base64url": "",
        "signature_base64url": "jteIk7vtRk7Jc5vjDxpfEEFR9pE4P4lcOFphpm5or5q0jeeMbfNbvb42haQpNaD7G3Ddn8ThIDdhH3JtUxv9CQ"
      },
      "expected_class": "lifetime_exceeded"
    },
    {
      "name": "not-before-beyond-skew",
      "token": "$positive.compact",
      "context_override": { "now": 1799999994 },
      "expected_class": "not_yet_valid"
    },
    {
      "name": "expiry-is-hard-boundary",
      "token": "$positive.compact",
      "context_override": { "now": 1800000060 },
      "expected_class": "expired"
    },
    {
      "name": "clock-health-gate",
      "token": "$positive.compact",
      "context_override": { "clock_healthy": false },
      "expected_class": "clock_unhealthy"
    },
    {
      "name": "workspace-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.workspace_id": "ws_other" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "endpoint-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.endpoint_id": "ep_other" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "cat-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.cat_id": "cat_other" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "generation-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.cat_generation": 8 },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "hostname-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.hostname": "other.cats.run" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "node-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.node_id": "node_other" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "epoch-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.route_epoch": 43 },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "protocol-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.protocol": "https" },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "port-local-truth-mismatch",
      "token": "$positive.compact",
      "context_override": { "local_authority.target_port": 9090 },
      "expected_class": "authority_mismatch"
    },
    {
      "name": "runtime-not-running",
      "token": "$positive.compact",
      "context_override": { "runtime_state": "Suspended" },
      "expected_class": "runtime_unavailable"
    },
    {
      "name": "quiesce-won-admission-race",
      "token": "$positive.compact",
      "context_override": { "quiesce_started": true },
      "expected_class": "runtime_unavailable"
    }
  ],
  "issuer_snapshot_cases": [
    {
      "name": "observed-running-but-settled-suspended",
      "snapshot_override": {
        "cats.observed_state": "Running",
        "cat_runtime_state.state": "suspended"
      },
      "expected": "issuer_rejects_non_authoritative_projection"
    },
    {
      "name": "heartbeat-running-without-settled-runtime",
      "snapshot_override": {
        "heartbeat.reported_state": "Running",
        "cat_runtime_state": null
      },
      "expected": "issuer_rejects_observation_without_settlement"
    },
    {
      "name": "settled-running-with-current-suspend-command",
      "snapshot_override": {
        "cat_runtime_state.state": "running",
        "current_command.kind": "Suspend",
        "current_command.phase": "dispatchable"
      },
      "expected": "issuer_rejects_nonterminal_invalidating_command"
    },
    {
      "name": "route-publication-provenance-mismatch",
      "snapshot_override": {
        "cat_runtime_state.result_id": "result_current",
        "route_publication.result_id": "result_stale"
      },
      "expected": "issuer_rejects_stale_route_publication"
    }
  ],
  "session_transition_cases": [
    {
      "name": "reachable-revoke-cancels-active-streams-before-transfer",
      "input": {
        "node_reachable": true,
        "old_authority": { "cat_generation": 7, "route_epoch": 42 },
        "active_guards": [
          { "kind": "websocket", "cat_generation": 7, "route_epoch": 42 },
          { "kind": "streaming_http", "cat_generation": 7, "route_epoch": 42 }
        ],
        "revoke_to_route_epoch": 43,
        "drain_result": "all_guards_zero"
      },
      "expected": {
        "old_epoch_new_admission": "rejected",
        "old_epoch_transports": "cancelled_and_closed",
        "control_plane_publication_order": "after_zero_guard_durable_ack",
        "authority_transfer": "allowed"
      }
    },
    {
      "name": "reachable-revoke-drain-timeout-blocks-transfer",
      "input": {
        "node_reachable": true,
        "old_authority": { "cat_generation": 7, "route_epoch": 42 },
        "active_guards": [
          { "kind": "websocket", "cat_generation": 7, "route_epoch": 42 }
        ],
        "revoke_to_route_epoch": 43,
        "drain_result": "timeout_one_guard_remaining",
        "external_fence_proof": null
      },
      "expected": {
        "control_plane_publication": "blocked",
        "authority_transfer": "forbidden"
      }
    },
    {
      "name": "unreachable-node-ttl-only-does-not-prove-silence",
      "input": {
        "node_reachable": false,
        "seconds_since_last_possible_issue": 125,
        "active_guard_state": "unknown",
        "runtime_serving_state": "unknown",
        "external_fence_proof": null
      },
      "expected": {
        "old_grant_new_admission": "exhausted",
        "authority_transfer": "forbidden"
      }
    },
    {
      "name": "unreachable-node-external-fence-allows-transfer",
      "input": {
        "node_reachable": false,
        "seconds_since_last_possible_issue": 0,
        "external_fence_proof": "persisted_cloud_power_off_receipt"
      },
      "expected": {
        "old_runtime_serving": "impossible",
        "authority_transfer": "allowed_after_fence_receipt"
      }
    },
    {
      "name": "ttl-plus-independent-zero-session-nonserving-proof-allows-transfer",
      "input": {
        "node_reachable": false,
        "seconds_since_last_possible_issue": 125,
        "independent_proof": {
          "active_guard_count": 0,
          "runtime_state": "durably_stopped",
          "source": "authenticated_pre_disconnect_retirement_receipt"
        }
      },
      "expected": {
        "authority_transfer": "allowed_after_proof_validation"
      }
    }
  ]
}
