  "issuer_snapshot_cases": [
    {
      "name": "observed-running-but-settled-suspended",
      "snapshot_override": {
        "cats.observed_state": "Running",
        "cat_runtime_state.state": "suspended"
      },
      "expected": "issuer_rejects_non_authoritative_projection"
    },
    {
      "name": "heartbeat-running-without-settled-runtime",
      "snapshot_override": {
        "heartbeat.reported_state": "Running",
        "cat_runtime_state": null
      },
      "expected": "issuer_rejects_observation_without_settlement"
    },
    {
      "name": "settled-running-with-current-command",
      "snapshot_override": {
        "current_lifecycle_command": {
          "authority": "current",
          "kind": "suspend",
          "phase": "dispatchable"
        }
      },
      "expected": "issuer_rejects_any_current_nonterminal_command"
    },
    {
      "name": "route-publication-result-provenance-mismatch",
      "snapshot_override": {
        "reducer_route_intent.settled_lineage.result_id": "nres_stale"
