#!/bin/busybox sh
set -eu

export PATH=/bin

busybox mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1
busybox mount -t proc proc /proc
busybox mount -t sysfs sysfs /sys

echo "cats-minimal-init: loading virtio_blk"
busybox insmod /lib/modules/virtio_blk.ko
echo "cats-minimal-init: loading virtio_net"
busybox insmod /lib/modules/failover.ko
busybox insmod /lib/modules/net_failover.ko
busybox insmod /lib/modules/virtio_net.ko

attempt=0
while [ ! -b /dev/vda1 ] && [ "$attempt" -lt 100 ]; do
  attempt=$((attempt + 1))
  busybox sleep 0.01
done

if [ ! -b /dev/vda1 ]; then
  echo "cats-minimal-init: /dev/vda1 did not appear"
  exec busybox sh
fi

attempt=0
while [ ! -e /sys/class/net/eth0 ] && [ "$attempt" -lt 100 ]; do
  attempt=$((attempt + 1))
  busybox sleep 0.01
done
if [ -e /sys/class/net/eth0 ]; then
  busybox ip link set eth0 up
  busybox ip address add 192.168.249.2/24 dev eth0
  echo "cats-minimal-init: configured 192.168.249.2/24 on eth0"
fi

echo "cats-minimal-init: mounting ext4 root"
busybox mount -t ext4 -o ro /dev/vda1 /newroot
busybox mount --move /dev /newroot/dev
busybox mount --move /proc /newroot/proc
busybox mount --move /sys /newroot/sys

echo "cats-minimal-init: switch_root"
exec busybox switch_root /newroot /sbin/init
